{
  "name": "traffic-shield",
  "version": "1.0.0",
  "description": "Distributed rate limiter with an AI-driven adaptive traffic classifier (token bucket + Redis + logistic regression classifier)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node src/server.js",
    "train": "node scripts/trainClassifier.js",
    "simulate:flashsale": "node scripts/simulateTraffic.js flashsale",
    "simulate:attack": "node scripts/simulateTraffic.js attack",
    "simulate:mixed": "node scripts/simulateTraffic.js mixed",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
